+/* MirrorDesk: the sender's FLUSH (after a pause or seek; RTP-Info seq=next_seq): drop what is
+ * older than next_seq, keep newer packets that arrived before the FLUSH was handled, and
+ * carry on from next_seq at once instead of waiting for the packets the sender skipped. */
+void raop_buffer_skip_to(raop_buffer_t *raop_buffer, int next_seq) {
+    assert(raop_buffer);
+
+    if (next_seq < 0 || next_seq > 0xffff) {
+        raop_buffer_flush(raop_buffer, -1);   /* no position given: start again with the next packet */
+        return;
+    }
+    if (raop_buffer->is_empty) {
+        return;   /* the next packet to arrive starts the buffer */
+    }
+    unsigned short next = (unsigned short) next_seq;
+    short ahead = seqnum_cmp(next, raop_buffer->first_seqnum);
+    if (ahead <= 0) {
+        return;   /* already there (the new packets were played before the FLUSH was handled) */
+    }
+    if (ahead >= RAOP_BUFFER_LENGTH || seqnum_cmp(next, raop_buffer->last_seqnum) > 0) {
+        raop_buffer_flush(raop_buffer, next);   /* nothing buffered is that new */
+        return;
+    }
+    while (seqnum_cmp(raop_buffer->first_seqnum, next) < 0) {
+        raop_buffer_entry_t *entry = &raop_buffer->entries[raop_buffer->first_seqnum % RAOP_BUFFER_LENGTH];
+        if (entry->filled) {
+            free(entry->payload_data);
+            entry->payload_data = NULL;
+            entry->payload_size = 0;
+            entry->filled = 0;
+        }
+        raop_buffer->first_seqnum += 1;
+    }
+}
+
